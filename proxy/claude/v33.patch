 // ============================================================
+// НОРМАЛИЗАЦИЯ ССЫЛОК НА MASTER-ФАЙЛЫ
+// ============================================================
+
+function normalizeMasterInstructionUrls(
+  value
+) {
+  const values = Array.isArray(value)
+    ? value
+    : [value];
+
+  return values
+    .map((item) =>
+      typeof item === "string"
+        ? item.trim()
+        : ""
+    )
+    .filter(Boolean);
+}
